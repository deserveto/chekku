# Combined deployment reference.
# For local development, copy agent/.env.example to agent/.env and
# client/.env.example to client/.env.local instead of using this file directly.

# Agent server
PORT=4111
HOST=localhost
# Postgres connection for Mastra storage. In dev, scripts/setup-env.sh injects
# the generated password into DATABASE_URL in agent/.env.development.
DATABASE_URL=postgresql://chekku:postgres@localhost:5432/chekku_agent
LOG_LEVEL=info
MASTRA_TELEMETRY_DISABLED=true
WEB_URL=http://localhost:3000

# Postgres container. In dev, scripts/setup-env.sh generates this into
# storage/.env.local (read by compose via --env-file). The agent does not read
# POSTGRES_PASSWORD directly — it uses DATABASE_URL above. For non-dev deploys
# where compose provisions the database, set this and ensure it matches the
# password embedded in DATABASE_URL.
POSTGRES_PASSWORD=
LLM_BASE_URL=https://llm.rafiqspace.ai/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=qwen3.6-35b-a3b-fast
LLM_DISPLAY_NAME=Rafiqspace LLM
LLM_MODELS=qwen3.6-35b-a3b-fast,qwen3.6-35b-a3b
CHEKKU_DEFAULT_AGENT_ID=main-agent
BROWSER_HEADLESS=true

# QA Android Agent (Maestro). Disabled by default; requires the Maestro CLI, ADB, and an emulator/device.
MAESTRO_ENABLED=false
MAESTRO_COMMAND=maestro
MAESTRO_WORKSPACE=../maestro
MAESTRO_ARTIFACT_DIR=../artifacts/maestro
MAESTRO_TIMEOUT_MS=120000
ADB_PATH=adb

# Server-owned SearXNG search endpoint. Local scripts/setup-env.sh supplies this.
SEARXNG_BASE_URL=
# Optional bearer token for an authenticated external SearXNG reverse proxy.
SEARXNG_API_KEY=

# Server-owned key for the fixed hosted Web Reader provider.
WEB_READER_API_KEY=

# Garage object storage
GARAGE_ENDPOINT=
GARAGE_REGION=
GARAGE_BUCKET=
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=

# Social Agent Telegram and email delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Chekku <onboarding@resend.dev>

# Client (Next.js) + Better Auth
AGENT_URL=http://localhost:4111
NEXT_PUBLIC_APP_URL=http://localhost:3000
AGENT_SERVICE_TOKEN=
# Better Auth email/password. In dev, npm run setup generates BETTER_AUTH_SECRET
# and wires AUTH_DATABASE_URL to the generated POSTGRES_PASSWORD in client/.env.local.
# In prod, inject these via the host platform; never commit them.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_DATABASE_URL=postgresql://chekku:postgres@localhost:5432/chekku_auth
RESEND_API_KEY=
RESEND_FROM_EMAIL=Chekku <onboarding@resend.dev>
RATE_LIMIT_TRUST_PROXY=

# Compose host port bindings. Empty keeps the defaults below, which local
# development depends on. Override only on a shared host where a default port is
# already taken; container-to-container addresses never change.
#   CHEKKU_GARAGE_HOST_PORT    default 3900   (agent/.env)
#   CHEKKU_SEARXNG_HOST_PORT   default 8888   (agent/.env)
#   CHEKKU_POSTGRES_HOST_PORT  default 5432   (agent/.env)
#   CHEKKU_CLIENT_HOST_PORT    default 3000   (client/.env.local)
CHEKKU_GARAGE_HOST_PORT=
CHEKKU_SEARXNG_HOST_PORT=
CHEKKU_POSTGRES_HOST_PORT=
CHEKKU_CLIENT_HOST_PORT=
