NODE_ENV=development
PORT=4111
HOST=localhost

# Postgres connection for Mastra storage. Leave empty for local dev —
# scripts/setup-env.sh constructs DATABASE_URL with the generated POSTGRES_PASSWORD
# and writes it to agent/.env.development. Set a non-empty value here only to
# override (e.g. a remote/staging Postgres); POSTGRES_PASSWORD itself stays in
# storage/.env.local (container-side, read by compose).
DATABASE_URL=

LOG_LEVEL=info
MASTRA_TELEMETRY_DISABLED=true
WEB_URL=http://localhost:3000

# One server-owned OpenAI-compatible endpoint.
# Never expose this key through a NEXT_PUBLIC_* variable.
LLM_BASE_URL=https://llm.rafiqspace.ai/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_DISPLAY_NAME=Rafiqspace LLM

# Optional comma-separated fallback list when GET /models is unavailable.
LLM_MODELS=deepseek-v4-flash,qwen3.6-35b-a3b-fast,qwen3.6-35b-a3b

# Fixed image-generation model for the Visual Content Agent's generate_image tool.
# The model id is fixed by configuration and never comes from tool/model input.
# Empty/unset -> generate_image fails closed with a configuration error.
LLM_IMAGE_MODEL=gemini-3.1-flash-image
# Narrowly-scoped path under LLM_BASE_URL for image generation. Defaults to the
# OpenAI Images API standard path; override only when the gateway exposes
# images under a different path.
#LLM_IMAGE_ENDPOINT_PATH=/images/generations

# Knowledge Base embedding model, resolved against LLM_BASE_URL + LLM_API_KEY
# (POST {LLM_BASE_URL}/embeddings). The model id is fixed by configuration and
# never comes from tool/model input. Empty/unset -> the Knowledge Base
# (ingestion workflow and search_knowledge_base tool) fails closed with a
# fixed configuration error. Changing the model changes the vector dimension;
# the ingestion pipeline refuses to write into a collection built for a
# different dimension.
LLM_EMBEDDING_MODEL=

CHEKKU_DEFAULT_AGENT_ID=main-agent
BROWSER_HEADLESS=true

# Per-user daily token quota across all agents (input + output tokens summed
# per user per UTC day). 0 disables enforcement. Counters are in-memory:
# an agent server restart gives users a fresh daily quota.
TOKEN_DAILY_LIMIT=500000

# QA Android Agent (Maestro). Disabled by default; requires the Maestro CLI, ADB, and an emulator/device.
MAESTRO_ENABLED=false
MAESTRO_COMMAND=maestro
MAESTRO_WORKSPACE=../maestro
MAESTRO_ARTIFACT_DIR=../artifacts/maestro
MAESTRO_TIMEOUT_MS=120000
ADB_PATH=adb

# Server-owned SearXNG search endpoint. Local scripts/setup-env.sh supplies this.
SEARXNG_BASE_URL=
# Optional bearer token for an authenticated external SearXNG reverse proxy.
SEARXNG_API_KEY=

# Self-hosted Jina Reader (OSS Docker image). scripts/setup-env.sh writes the
# canonical dev URL (http://127.0.0.1:8081) into agent/.env.development; in
# prod compose the service name resolves it (http://reader:8081). The Reader
# container is stateless and unauthenticated — no API key is required.
# Empty/unset → read_web_page fails closed with a fixed configuration error.
WEB_READER_BASE_URL=

# Knowledge Base vector index (Qdrant). scripts/setup-env.sh writes the
# canonical dev URL (http://127.0.0.1:6333) into agent/.env.development; in
# prod compose the service name resolves it (http://qdrant:6333). Qdrant is
# reachable only by the agent server — never the browser. Empty/unset -> all
# Knowledge tools and workflows fail closed with a fixed configuration error.
QDRANT_URL=
# Optional API key for Qdrant deployments with auth enabled (the local
# Compose service runs without one).
QDRANT_API_KEY=
# Single shared collection for every user's knowledge; tenant isolation is
# enforced by a mandatory resourceId payload filter, not by per-user
# collections.
QDRANT_COLLECTION=chekku_knowledge

# Public Holiday Indonesia API. The weekly-social-drafts workflow calls this
# to resolve movable feasts (Idul Fitri, Idul Adha, Tahun Baru Islam / 1
# Muharram, Isra Mi'raj, Maulid Nabi, Nyepi, Paskah, Waisak, Natal). Defaults
# to the public api-hari-libur instance; override only to point at a mirror.
PUBLIC_HOLIDAY_API_BASE_URL=https://api-hari-libur.vercel.app/api
#PUBLIC_HOLIDAY_CACHE_DIR=src/mastra/calendar/.cache

# Garage object storage. scripts/setup-env.sh generates local values.
GARAGE_ENDPOINT=
GARAGE_REGION=
GARAGE_BUCKET=
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=

# Telegram adapter for the social-media-content-writer.
# TELEGRAM_MODE: polling (dev), webhook (prod), or auto.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Email outbound (Resend) for the send-email tool.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Chekku <onboarding@resend.dev>

# Recipient of the weekly social-draft review email (scheduled workflow).
# The weekly-social-drafts workflow emails a review link here every Monday
# 09:00 Asia/Jakarta. Required per environment — there is no default. When
# unset, the workflow still drafts and saves posts but skips the email step.
# Set the real recipient in agent/.env (not committed).
SOCIAL_DRAFT_REVIEW_EMAIL=

# Host port bindings for the Compose infra services. Leave empty to keep the
# defaults (3900 / 8888 / 5432), which is what local development expects —
# scripts/dev.sh probes those ports and storage/.env.local and searxng/.env.local
# pin GARAGE_ENDPOINT and SEARXNG_BASE_URL to them. Set these only on a shared
# host where the default port already belongs to another stack. They move the
# host side of the publish only; containers always reach each other on
# garage:3900, searxng:8080, and postgres:5432.
#
# Read by scripts/prod.sh, which merges this file into the shell before calling
# Compose. scripts/dev.sh reads storage/.env.local instead, so values set here
# do not affect local development.
CHEKKU_GARAGE_HOST_PORT=
CHEKKU_SEARXNG_HOST_PORT=
CHEKKU_READER_HOST_PORT=
CHEKKU_POSTGRES_HOST_PORT=
CHEKKU_QDRANT_HOST_PORT=
