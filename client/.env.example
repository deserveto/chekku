# Server-only upstream used by the Next.js proxy.
AGENT_URL=http://localhost:4111

# Public URL of this Next.js application.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development identity seam. Replace with OIDC in production.
CHEKKU_LOCAL_USER_ID=local-user

# Optional server-to-server credential for the Mastra hop.
AGENT_SERVICE_TOKEN=

# Better Auth (email/password). Secret must be 32+ random chars in real deployments.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_DATABASE_URL=postgresql://chekku:chekku@localhost:5432/chekku_auth
